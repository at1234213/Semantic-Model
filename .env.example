# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- App ---
APP_NAME=semantic-model
ENV=development
DEBUG=true
LOG_LEVEL=info
API_PORT=8000

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=semantic_model
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/semantic_model

# --- Model / embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Secrets ---
SECRET_KEY=change-me
